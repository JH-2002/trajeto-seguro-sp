{
  "name": "trajeto-seguro-sp",
  "version": "0.1.0",
  "private": true,
  "description": "Mapa 3D interativo de criminalidade (SSP-SP) e acidentes (Infosiga-SP) em São Paulo, com sugestão de rotas mais seguras.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "data": "tsx scripts/prepare-data.ts --municipio S.PAULO",
    "data:scrape": "tsx scripts/scrape-ssp.ts",
    "data:lighting": "tsx scripts/fetch-lighting.ts",
    "data:update": "tsx scripts/scrape-ssp.ts && npm run data -- --raw-dir data/raw",
    "data:demo": "tsx scripts/generate-demo.ts"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "^9.1.0",
    "@deck.gl/core": "^9.1.0",
    "@deck.gl/geo-layers": "^9.1.0",
    "@deck.gl/layers": "^9.1.0",
    "@deck.gl/mapbox": "^9.1.0",
    "maplibre-gl": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "exceljs": "^4.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
