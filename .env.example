# Estilo do mapa base (MapLibre). O padrão é o tema escuro gratuito do OpenFreeMap,
# que traz a altura dos prédios para a camada 3D.
VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/dark

# Servidores OSRM por modo de deslocamento (FOSSGIS / routing.openstreetmap.de).
# Para uso intenso, suba seu próprio OSRM (docker) e aponte para ele aqui.
VITE_OSRM_FOOT=https://routing.openstreetmap.de/routed-foot
VITE_OSRM_BIKE=https://routing.openstreetmap.de/routed-bike
VITE_OSRM_CAR=https://routing.openstreetmap.de/routed-car

# Geocodificador com autocompletar (Photon / komoot).
VITE_PHOTON_URL=https://photon.komoot.io
